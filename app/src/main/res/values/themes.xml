<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CorosThemeLight" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#007E78</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
    <style name="CorosThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">#48D4C5</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
